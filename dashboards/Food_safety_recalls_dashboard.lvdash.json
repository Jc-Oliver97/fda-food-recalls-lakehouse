      }
    },
    {
      "name": "0e40e8be",
      "displayName": "gold_recalls_by_year_hazard",
      "config": {
        "version": "1.1",
        "source": "workspace.food_safety.gold_recalls_by_year_hazard",
        "dimensions": [
          {
            "name": "report_year",
            "expr": "source.report_year"
          },
          {
            "name": "hazard_category",
            "expr": "source.hazard_category"
          },
          {
            "name": "classification",
            "expr": "source.classification"
          }
        ],
        "measures": [
          {
            "name": "recalls",
            "expr": "SUM(source.recalls)"
          },
          {
            "name": "open_recalls",
            "expr": "SUM(source.open_recalls)"
          }
        ]
      }
    },
    {
      "name": "b9ef7c5e",
      "displayName": "gold_recall_duration",
      "config": {
        "version": "1.1",
        "source": "workspace.food_safety.gold_recall_duration",
        "dimensions": [
          {
            "name": "hazard_category",
            "expr": "source.hazard_category"
          },
          {
            "name": "classification",
            "expr": "source.classification"
          }
        ],
        "measures": [
          {
            "name": "avg_days_open",
            "expr": "AVG(source.avg_days_open)"
          },
          {
            "name": "median_days_open",
            "expr": "AVG(source.median_days_open)"
          },
          {
            "name": "closed_recalls",
            "expr": "SUM(source.closed_recalls)"
          }
        ]
      }
    },
    {
      "name": "afefd805",
      "displayName": "gold_top_firms",
      "config": {
        "version": "1.1",
        "source": "workspace.food_safety.gold_top_firms",
        "dimensions": [
          {
            "name": "recalling_firm",
            "expr": "source.recalling_firm",
            "displayName": "Recalling Firm"
          }
        ],
        "measures": [
          {
            "name": "total_recalls",
            "expr": "SUM(source.total_recalls)",
            "displayName": "Total Recalls"
          },
          {
            "name": "class_i_recalls",
            "expr": "SUM(source.class_i_recalls)",
            "displayName": "Class I Recalls"
          },
          {
            "name": "distinct_hazards",
            "expr": "SUM(source.distinct_hazards)",
            "displayName": "Distinct Hazards"
          }
        ]
      }
    },
    {
      "name": "563eed28",
      "displayName": "gold_dq_expectations",
      "config": {
        "version": "1.1",
        "source": "workspace.food_safety.gold_dq_expectations",
        "dimensions": [
          {
            "name": "dataset",
            "expr": "source.dataset",
            "displayName": "Dataset"
          },
          {
            "name": "expectation",
            "expr": "source.expectation",
            "displayName": "Expectation"
          },
          {
            "name": "last_run",
            "expr": "source.last_run",
            "displayName": "Last Run"
          }
        ],
        "measures": [
          {
            "name": "passed_records",
            "expr": "SUM(source.passed_records)",
            "displayName": "Passed Records"
          },
          {
            "name": "failed_records",
            "expr": "SUM(source.failed_records)",
            "displayName": "Failed Records"
          },
          {
            "name": "failure_pct",
            "expr": "AVG(source.failure_pct)",
            "displayName": "Failure %",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "063f9ffd",
      "displayName": "silver_recall_events_quarantine",
      "config": {
        "version": "1.1",
        "source": "workspace.food_safety.silver_recall_events_quarantine",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "8b14c32c",
      "displayName": "main-kpis",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(*)                                                    AS total_recalls,\r\n",
        "  COUNT_IF(status = 'Ongoing')                                AS open_recalls,\r\n",
        "  ROUND(100 * COUNT_IF(classification = 'Class I') / COUNT(*), 1) AS pct_class_i\r\n",
        "FROM workspace.food_safety.gold_recalls_current;\r\n"
      ]
    }
  ],
